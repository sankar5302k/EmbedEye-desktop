# Local Neural Reranker (100% Offline, runs locally on GPU/CPU)
RERANKER_MODEL_NAME=mixedbread-ai/mxbai-rerank-large-v1
RERANKER_BATCH_SIZE=16

# Florence-2 Model Configuration (Captioning + OCR in one model)
# Options: microsoft/Florence-2-large (higher quality, ~1.5GB VRAM) or microsoft/Florence-2-base (faster, ~0.5GB VRAM)
FLORENCE_MODEL_NAME=microsoft/Florence-2-large
FLORENCE_BATCH_SIZE=2
FLORENCE_MAX_NEW_TOKENS=256
FLORENCE_NUM_BEAMS=3

# CLIP Batch Size (fp16 on CUDA)
CLIP_BATCH_SIZE=16

# OCR Post-Processing & RapidOCR Fallback (CPU only, uses 0 VRAM)
USE_RAPIDOCR=true
MAX_OCR_CHARS=1000

# Offline mode: Set to 1 to run completely offline without checking Hugging Face Hub
HF_HUB_OFFLINE=0

# Device override (auto, cuda, cpu)
DEVICE_OVERRIDE=auto

# OCR-Only Mode Configuration
# Engine options: tesseract (system binary), rapidocr (CPU onnxruntime, 0 VRAM), florence (Florence-2 GPU OCR)
OCR_ENGINE=tesseract
OCR_WORKERS=2
OCR_MIN_CONF=0.5
OCR_MAX_SIDE=2000
CHUNK_WORDS=250
CHUNK_OVERLAP=30
OCR_COLLECTION=docs_ocr
OCR_LANGS=en
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
